# Original sphere STL, radius 0.203, center (0,0,0); dimensionless ideal gas.
# Domain 3.1875 x 2.125 x 2.125; D/h_finest=12.23.
# Inflow at x-low; extrapolation on remaining far-field boundaries.
# Transient demonstration, not a steady-flow or grid-converged benchmark.
case = external_flow
max_step = 200000
geometry.coord_sys = 0
geometry.is_periodic = 0 0 0
geometry.prob_lo = -1.0625 -1.0625 -1.0625
geometry.prob_hi = 2.125 1.0625 1.0625
amr.n_cell = 48 32 32
amr.blocking_factor = 8
amr.max_grid_size = 32
amr.checkpoint_files_output = 1
amr.check_file = chk
amr.check_int = 100
amr.plot_files_output = 1
amr.plot_file = plt
amr.plot_int = 50
amr.derive_plot_vars = pressure x_velocity y_velocity z_velocity
hypereb.lo_bc = 1 2 2
hypereb.hi_bc = 2 2 2
hypereb.cfl = 0.3
hypereb.do_reflux = 1
eb2.stl_file = geometry/sphere.stl
eb2.stl_scale = 1
eb2.stl_center = 0 0 0
eb2.stl_reverse_normal = 0
eb2.cover_multiple_cuts = 1
physics.gamma = 1.4
physics.R_specific = 1
prob.rho_inf = 1
prob.p_inf = 1
prob.gas_constant = 1
diagnostics.residual_int = 20
diagnostics.residual_file = residual.csv
diagnostics.force_int = 20
diagnostics.surface_int = 0
# Several body-flow times; verify actual step count >=200 from exported output.
stop_time = 1.25
prob.mach_inf = 2
eb2.geom_type = stl
eb2.dynamic_geometry = 1
eb2.wall_translation = 0.15 0.05 0
eb2.wall_acceleration = 0 0 0
hypereb.moving_wall_cfl = 0.5
physics.do_diffusion = 0
physics.eb_wall_diffusion = 0
amr.max_level = 1
amr.subcycling_mode = None
amr.ref_ratio = 2
amr.regrid_int = 2
amr.n_error_buf = 2
hypereb.refine_cutcells = 1
hypereb.refine_max_pressure_jump_lev = 1
hypereb.refine_pressure_jump = 0.05
